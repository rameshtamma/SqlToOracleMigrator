<Window x:Class="SqlToOracleMigrator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SqlToOracleMigrator.Desktop.ViewModels"
        xmlns:conv="clr-namespace:SqlToOracleMigrator.Desktop.Converters"
        Title="SQL Server → Oracle Migrator" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel>
        <!-- Top action bar -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="0,0,8,0" Padding="10,6"
                        Command="{Binding NewConnectionCommand}" ToolTip="Create and save a new SQL Server or Oracle connection profile. Use this first to register source/target endpoints (stored under Data/Config).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="16" Margin="0,0,6,0"/>
                        <TextBlock Text="New Database Connection"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Margin="0,0,8,0" Padding="10,6"
                        Command="{Binding OpenLogsFolderCommand}" ToolTip="Open the local logs folder for this tool. Use this to review run diagnostics, errors, and stage outputs.">
                    <TextBlock Text="Open Logs Folder"/>
                </Button>

                <Button Grid.Column="2" Margin="0,0,8,0" Padding="10,6"
                        Command="{Binding RefreshInventoryCommand}" ToolTip="Re-scan connected endpoints and rebuild the Combined Inventory view (schemas, tables, views, procedures, sequences, etc.). Run after connecting or after changes in source/target.">
                    <TextBlock Text="Refresh Inventory"/>
                </Button>

                <Button Grid.Column="3" Margin="0,0,8,0" Padding="10,6"
                        Command="{Binding CreateTargetPdbCommand}" ToolTip="Launch the PDB creation wizard. Requires a SYS/SYSDBA connection. Creates/drops PDBs and prepares the target container.">
                    <TextBlock Text="Create Target PDB"/>
                </Button>

                <Button Grid.Column="4" Margin="0,0,8,0" Padding="10,6"
                        Command="{Binding ValidateMigrationCommand}" ToolTip="Open post-migration validation. Compares source vs target for selected objects/rows to confirm completeness and data quality.">
                    <TextBlock Text="Validate Migration"/>
                </Button>

                <TextBlock Grid.Column="6" VerticalAlignment="Center" Foreground="#666"
                           Text="{Binding StatusText}" />

                <Button Grid.Column="7" Margin="8,0,0,0" Padding="10,6"
                        Command="{Binding CloseAppCommand}" ToolTip="Close the application. All active connections and resources will be released safely.">
                    <TextBlock Text="Close" />
                </Button>
            </Grid>
        </Border>

        <!-- Main layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Connections panel -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Connections"
                               FontWeight="SemiBold" FontSize="14"
                               Padding="10,10,10,6"/>
                    <TreeView ItemsSource="{Binding ConnectionGroups}" Margin="6"
                              SelectedItemChanged="ConnectionsTree_SelectedItemChanged"
                              PreviewMouseDoubleClick="ConnectionsTree_PreviewMouseDoubleClick" ToolTip="Connections tree. Right-click a connection to Connect/Disconnect/Reset, open its config folder, or remove it. Double-click to connect/open.">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeGroupNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:ConnectionNodeViewModel}" ItemsSource="{Binding Children}">
	                                <StackPanel Orientation="Horizontal">
	                                    <StackPanel.ContextMenu>
	                                        <ContextMenu>
	                                            <MenuItem Header="Connect" Command="{Binding ConnectCommand}"/>
	                                            <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}"/>
	                                            <MenuItem Header="Reset" Command="{Binding ResetCommand}"/>
	                                            <Separator/>
	                                            <MenuItem Header="Remove" Command="{Binding RemoveCommand}"/>
	                                            <MenuItem Header="Open Config Folder" Command="{Binding OpenConfigFolderCommand}"/>
	                                        </ContextMenu>
	                                    </StackPanel.ContextMenu>
	                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0"
	                                             Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
	                                    <TextBlock Text="{Binding DisplayName}"/>
	                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:DatabaseNodeViewModel}" ItemsSource="{Binding Children}">
	                                <StackPanel Orientation="Horizontal">
	                                    <StackPanel.ContextMenu>
	                                        <ContextMenu>
	                                            <MenuItem Header="Migrate data"
	                                                      Command="{Binding MigrateDataCommand}"
	                                                      Visibility="{Binding IsSqlDatabaseNode, Converter={StaticResource BoolToVisibilityConverter}}"/>
	                                        </ContextMenu>
	                                    </StackPanel.ContextMenu>
	                                    <TextBlock Text="{Binding DisplayName}"/>
	                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Combined inventory -->
            <Border Grid.Row="0" Grid.Column="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Combined Inventory (read-only)"
                               FontWeight="SemiBold" FontSize="14"
                               Padding="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding InventoryRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              RowDetailsVisibilityMode="Visible"
                              SelectionMode="Single"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.IsDeferredScrollingEnabled="True" ToolTip="Combined Inventory is read-only metadata from both SQL Server and Oracle. Expand a row to view detailed objects. Use it to estimate size/complexity and verify what will be migrated.">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="DetailsVisibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="DetailsVisibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,6,0,6" Padding="8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Objects" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ObjectsCountLabel}" Margin="8,0,0,0" Foreground="#666"/>
                                            <TextBlock Text="Loading..." Margin="12,0,0,0" Foreground="#666"
                                                       Visibility="{Binding IsLoadingObjects, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <DataGrid ItemsSource="{Binding Objects}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                                  MaxHeight="360">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="40">
                                                    <DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Button Content="▶" Width="26" Height="24" Padding="0"
                                                                    ToolTip="Load more rows"
                                                                    Command="{Binding LoadMoreCommand}"
                                                                    Visibility="{Binding HasMoreObjects, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.HeaderTemplate>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="140"/>
                                                <DataGridTextColumn Header="Object Name" Binding="{Binding ObjectName}" Width="220"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding ObjectType}" Width="120"/>
                                                <DataGridTextColumn Header="Rows" Binding="{Binding EstimatedRows}" Width="100"/>
                                                <DataGridTextColumn Header="Size (MB)" Binding="{Binding EstimatedSizeMb}" Width="100"/>
                                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate}" Width="160"/>
                                                <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedDate}" Width="160"/>
                                                <DataGridTextColumn Header="Depends On" Binding="{Binding DependsOnCount}" Width="90"/>
                                                <DataGridTextColumn Header="Depended By" Binding="{Binding DependedByCount}" Width="90"/>
                                                <DataGridTextColumn Header="Complexity" Binding="{Binding ComplexityScore}" Width="90"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding MigrationStatus}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded}" Content="▸" Width="26" Height="22" ToolTip="Expand/collapse details for this inventory row (shows underlying objects and migration status)."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="80"/>
                            <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="140"/>
                            <DataGridTextColumn Header="Database/Service" Binding="{Binding DatabaseOrService}" Width="220"/>
                            <DataGridTextColumn Header="Default Schema/User" Binding="{Binding DefaultSchemaOrUser}" Width="160"/>
                            <DataGridTextColumn Header="DB Size (GB)" Binding="{Binding DatabaseSizeGb}" Width="110"/>
                            <DataGridTextColumn Header="Data Size (GB)" Binding="{Binding DataSizeGb}" Width="110"/>
                            <DataGridTextColumn Header="Log/Redo (GB)" Binding="{Binding LogOrRedoSizeGb}" Width="110"/>
                            <DataGridTextColumn Header="#Schemas" Binding="{Binding SchemaCount}" Width="90"/>
                            <DataGridTextColumn Header="#Tables" Binding="{Binding TableCount}" Width="90"/>
                            <DataGridTextColumn Header="#Views" Binding="{Binding ViewCount}" Width="90"/>
                            <DataGridTextColumn Header="#Procs" Binding="{Binding ProcedureCount}" Width="90"/>
                            <DataGridTextColumn Header="#Funcs" Binding="{Binding FunctionCount}" Width="90"/>
                            <DataGridTextColumn Header="#Seq" Binding="{Binding SequenceCount}" Width="70"/>
                            <DataGridTextColumn Header="#Syn" Binding="{Binding SynonymCount}" Width="70"/>
                            <DataGridTextColumn Header="#Trig" Binding="{Binding TriggerCount}" Width="70"/>
                            <DataGridTextColumn Header="#Idx" Binding="{Binding IndexCount}" Width="70"/>
                            <DataGridTextColumn Header="Last Stats Update" Binding="{Binding LastStatsUpdate}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Logs -->
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,1,0,0" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="14"/>
                        <ProgressBar Width="220" Height="16" Margin="12,2,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding MigrationProgressPercent}" ToolTip="Overall migration progress for the current run. Stages update this value as objects/batches complete."/>
                        <TextBlock Text="{Binding MigrationStageText}" Margin="8,0,0,0" Foreground="#666" VerticalAlignment="Center"/>
                        <Button Content="Clear" Margin="12,0,0,0" Padding="10,2" Command="{Binding ClearLogsCommand}" ToolTip="Clear the on-screen log list (does not delete log files on disk)."/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding LogEntries}" ToolTip="Live run log output. For full details and stack traces, use Open Logs Folder to view the persisted log files.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
