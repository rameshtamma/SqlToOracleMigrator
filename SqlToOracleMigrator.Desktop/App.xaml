<Application x:Class="SqlToOracleMigrator.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Global tooltip UX: readable, wraps, and stays long enough to read -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
            <Setter Property="Placement" Value="Mouse"/>
        </Style>

        <!-- Make tooltips appear quickly and also show on disabled controls -->
        <Style TargetType="{x:Type FrameworkElement}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
</Style>


    </Application.Resources>
</Application>
